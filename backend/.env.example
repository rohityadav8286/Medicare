# Copy these values into backend/.env and replace the placeholders.
MONGO_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Create a separate Clerk application for admin accounts. Never reuse the
# patient Clerk secret key here.
ADMIN_CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# Use a unique, long password. This value is checked only by the backend.
ADMIN_DASHBOARD_PASSWORD=
ADMIN_CLERK_SECRET_KEY=

# Comma-separated Clerk emails that may access the admin dashboard.
# Patient and doctor emails must not be listed here.
ADMIN_EMAILS=
